<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movimiento de inventario"
            android:textColor="#17365D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Registra entradas y salidas de productos"
            android:textColor="#68778B"
            android:textSize="14sp" />

        <!-- Selección de producto -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Seleccionar producto"
            android:textStyle="bold"
            android:textColor="#17365D" />

        <Spinner
            android:id="@+id/spProducts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Tipo de movimiento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tipo de movimiento"
            android:textStyle="bold"
            android:textColor="#17365D" />

        <RadioGroup
            android:id="@+id/rgMovement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEntry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16834A"
                android:text="Entrada"
                android:textColor="#16834A"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:buttonTint="#D14343"
                android:text="Salida"
                android:textColor="#D14343"
                android:textStyle="bold" />

        </RadioGroup>

        <!-- Cantidad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cantidad"
            android:textStyle="bold"
            android:textColor="#17365D" />

        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="Ej: 10"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="#25364D"
            android:textColorHint="#98A2B3" />

        <!-- Registrar -->
        <Button
            android:id="@+id/btnRegisterMovement"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#7654C8"
            android:text="Registrar movimiento"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Volver -->
        <Button
            android:id="@+id/btnMovementBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#17365D"
            android:text="Volver al inicio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
