<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#17365D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StockControl"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Gestión inteligente de inventario"
                    android:textColor="#DCE7F5"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="#FFFFFF"
                android:textSize="42sp" />

        </LinearLayout>

        <!-- RESUMEN DEL INVENTARIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Resumen del inventario"
            android:textColor="#17365D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRODUCTOS"
                    android:textColor="#68778B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTotalProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="0"
                    android:textColor="#17365D"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrados"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="14dp"
                android:background="#E5E7EB" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STOCK BAJO"
                    android:textColor="#68778B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtLowStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="0"
                    android:textColor="#D97706"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requieren atención"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ACCESOS RÁPIDOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Accesos rápidos"
            android:textColor="#17365D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- FILA 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnProducts"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tile_blue"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="8dp"
                android:text="⌕&#10;Inventario"
                android:textAllCaps="false"
                android:textColor="#17365D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddProduct"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tile_green"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="8dp"
                android:text="+&#10;Agregar"
                android:textAllCaps="false"
                android:textColor="#176B45"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FILA 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMovements"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tile_purple"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="8dp"
                android:text="⇄&#10;Movimientos"
                android:textAllCaps="false"
                android:textColor="#6241A5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMovementHistory"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tile_blue"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:padding="8dp"
                android:text="◷&#10;Historial"
                android:textAllCaps="false"
                android:textColor="#17365D"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ALERTAS -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLowStock"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tile_orange"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:padding="8dp"
            android:text="⚠  Alertas de stock bajo"
            android:textAllCaps="false"
            android:textColor="#A64B08"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
